# ==========================================
# StudentAssistant Configuration Template
# ==========================================

# Google Gemini AI API Configuration
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_group_or_channel_id
# Allowed Telegram user IDs (comma-separated). Run /myid in the bot to get your ID.
ALLOWED_TELEGRAM_USERS=
# Optional: Local Telegram Bot API server for 2GB file downloads (e.g. http://127.0.0.1:8081)
# TELEGRAM_API_SERVER=http://127.0.0.1:8081

# GitHub Integration
GITHUB_REPO_URL=https://github.com/username/university-lectures.git
GITHUB_TOKEN=your_github_token_here
GITHUB_BRANCH=main

# Slide Deduplication Settings
SLIDE_SIMILARITY_THRESHOLD=0.95
SLIDE_CAPTURE_INTERVAL_SEC=5

# Timezone (e.g. Europe/Moscow for UTC+3)
TIMEZONE=Europe/Moscow

# Mode: set to true to test pipeline without calling external APIs
SIMULATION_MODE=false
